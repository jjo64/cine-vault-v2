# Configuración del servidor
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
EMAIL_PUBLIC_URL=https://cinevault.art

# API de TMDB (Obtén tu propia key en themoviedb.org)
API_KEY_TMDB=tu_api_key_aqui

# Base de Datos (MySQL/MariaDB)
# Local (XAMPP): mysql://root:password@localhost:3306/cinevault
# Docker: Usar la que se genera automáticamente en docker-compose
DATABASE_URL="mysql://cinevault_user:cinevault_pass@localhost:3306/cinevault"
DATABASE_USER="cinevault_user"
DATABASE_PASSWORD="cinevault_pass"
DATABASE_NAME="cinevault"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# Seguridad — Tokens JWT
JWT_SECRET="una_palabra_secreta_muy_larga"
REFRESH_SECRET="otra_palabra_secreta_diferente"
VERIFY_EMAIL_SECRET="secreto_verificacion_email"
TWO_FACTOR_ENCRYPTION_KEY="clave_32_caracteres_para_2fa"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Stripe (Pagos)
STRIPE_SECRET_KEY=sk_test_tu_clave_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret
STRIPE_PRICE_VIP=price_vip
STRIPE_PRICE_PRO=price_pro

# Email (SMTP / Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_password_de_aplicacion

# Resend (Emails Transaccionales - Alternativa a SMTP)
RESEND_API_KEY=
RESEND_FROM="CineVault <hola@mail.cinevault.art>"
EMAIL_SIMULATE=false

# OAuth Google (Login Social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (Uploads de imagen)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Otros
PERSPECTIVE_AI=tu_google_cloud_api_key_para_perspective
